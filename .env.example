# Web app. MUST be the unprivileged role (no superuser, no BYPASSRLS, not table owner) or RLS is void.
DATABASE_URL=postgres://elessons_app:CHANGE_ME@localhost:5432/elessons_dev
# Schema owner. Used ONLY by scripts/migrate.ts and scripts/seed.ts, never by the running app.
MIGRATE_DATABASE_URL=postgres://localhost:5432/elessons_dev
# Background worker (pnpm worker). The ONLY role that bypasses RLS; never give this URL to the web app.
WORKER_DATABASE_URL=postgres://elessons_worker:CHANGE_ME@localhost:5432/elessons_dev
# Where finished exports are written (local disk until object storage is configured)
EXPORT_DIR=storage/exports
# Tests (pnpm test resets this database every run)
TEST_MIGRATE_DATABASE_URL=postgres://localhost:5432/elessons_test
# Dev/test seed only. The seed refuses to run on databases not ending _dev/_test.
SEED_PASSWORD=

# Added by later phases, deliberately absent until code reads them:
#   Phase 3: STORAGE_*, META_APP_ID, META_APP_SECRET, META_VERIFY_TOKEN, ENCRYPTION_KEY
#   Phase 4: PAYMENT_*                           Phase 5: WHATSAPP_*, EMAIL_*
